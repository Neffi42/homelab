{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":automergePr",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Paris)"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "ignoreTests": true
    },
    {
      "description": "linuxserver/qbittorrent tags embed the qBittorrent version itself (e.g. 5.2.3_v2.0.15-ls478), not a date/build counter like the old 20.04.1 scheme - plain semver would compare 20.x as newer than 5.x and silently stop proposing updates, which is exactly what happened. This scopes matches to that tag shape and orders on the real major.minor.patch, with the ls<N> build number as a tie-breaker.",
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v[\\d.]+-ls(?<revision>\\d+)$"
    }
  ],
  "dependencyDashboardTitle": "Renovate Dashboard",
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "ignorePaths": [],
  "flux": {
    "managerFilePatterns": ["/\\.yaml(?:\\.j2)?$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/\\.yaml(?:\\.j2)?$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml(?:\\.j2)?$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Apply an explicit forgejo digest field match",
      "managerFilePatterns": ["/values\\.ya?ml/"],
      "matchStrings": [
        "(?<depName>forgejo\\/forgejo)\\n(?<indentation>\\s+)tag: (?<currentValue>[^@].*?)\\n\\s+digest: (?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "code.forgejo.org/{{depName}}",
      "autoReplaceStringTemplate": "{{depName}}\n{{indentation}}tag: {{newValue}}\n{{indentation}}digest: {{#if newDigest}}{{{newDigest}}}{{else}}{{{currentDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track the Flux distribution version pinned in the FluxInstance",
      "managerFilePatterns": ["/flux-instance\\.yaml$/"],
      "matchStrings": [
        "distribution:\\n\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "controlplaneio-fluxcd/distribution",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "helm-values heuristic isn't catching jellyfin's image for unknown reasons (confirmed: zero Renovate-authored commits ever touched this dep) - force it via explicit regex",
      "managerFilePatterns": ["/media\\/jellyfin\\/app\\/helmRelease\\.yaml$/"],
      "matchStrings": [
        "repository: (?<depName>docker\\.io/jellyfin/jellyfin)\\n\\s+tag: \"(?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Same helm-values gap for continuwuity's unbound sidecar image (confirmed: never bumped, unlike the main continuwuity image in the same file)",
      "managerFilePatterns": ["/matrix\\/continuwuity\\/app\\/helmRelease\\.yaml$/"],
      "matchStrings": [
        "repository: (?<depName>docker\\.io/madnuttah/unbound)\\n\\s+tag: (?<currentValue>[^@]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
